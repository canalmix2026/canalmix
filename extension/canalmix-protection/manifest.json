{
  "manifest_version": 3,
  "name": "CanalMix | Proteção experimental",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Bloqueia pedidos de publicidade observados nos testes do CanalMix.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Proteção do CanalMix",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
