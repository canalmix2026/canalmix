# Desenvolvimento local: use o Supabase iniciado pelo Docker.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55621
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; npm run supabase:env fills this for the local stack.
SUPABASE_SERVICE_ROLE_KEY=

# Na Vercel, configure estas variáveis com o URL e a chave publicável do projeto hospedado.
# Nunca use uma chave service_role em variáveis NEXT_PUBLIC_ ou no navegador.
